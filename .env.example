# Flickr API key for the Photos page album auto-pull (SERVER-SIDE ONLY — never
# shipped to the browser). Get one free (takes ~1 min):
#   https://www.flickr.com/services/apps/create/apply  → choose "Apply for a
#   Non-Commercial Key" → name it (e.g. "Fremont ASB site") → copy the Key.
# Then: copy this file to ".env" and paste the key below. Do NOT commit .env.
# On Vercel, add the same variable under Project → Settings → Environment Variables.
FLICKR_API_KEY=
